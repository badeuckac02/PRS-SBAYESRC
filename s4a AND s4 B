extract_term <- function(x, term_name) {

  y <- x$table[
    x$table$term == term_name,
    ,
    drop = FALSE
  ]

  if (nrow(y) != 1) {
    stop(
      paste(
        "Expected one",
        term_name,
        "row; found",
        nrow(y)
      )
    )
  }

  y
}

make_S4 <- function(outcome) {

  f_pgs <- extract_term(
    results[[outcome]]$Female,
    "CMP_PGS_Z"
  )

  f_age <- extract_term(
    results[[outcome]]$Female,
    "AGE"
  )

  m_pgs <- extract_term(
    results[[outcome]]$Male,
    "CMP_PGS_Z"
  )

  m_age <- extract_term(
    results[[outcome]]$Male,
    "AGE"
  )

  int <- results[[outcome]]$Interaction$interaction

  out <- data.frame(
    Outcome = outcome,

    Female_N =
      results[[outcome]]$Female$N,

    Female_PGS_OR =
      f_pgs$OR,

    Female_PGS_CI_low =
      f_pgs$CI_low,

    Female_PGS_CI_high =
      f_pgs$CI_high,

    Female_PGS_raw_p =
      f_pgs$raw_p,

    Female_AGE_OR =
      f_age$OR,

    Female_AGE_CI_low =
      f_age$CI_low,

    Female_AGE_CI_high =
      f_age$CI_high,

    Female_AGE_raw_p =
      f_age$raw_p,

    Male_N =
      results[[outcome]]$Male$N,

    Male_PGS_OR =
      m_pgs$OR,

    Male_PGS_CI_low =
      m_pgs$CI_low,

    Male_PGS_CI_high =
      m_pgs$CI_high,

    Male_PGS_raw_p =
      m_pgs$raw_p,

    Male_AGE_OR =
      m_age$OR,

    Male_AGE_CI_low =
      m_age$CI_low,

    Male_AGE_CI_high =
      m_age$CI_high,

    Male_AGE_raw_p =
      m_age$raw_p,

    Interaction_N =
      results[[outcome]]$Interaction$N,

    PGSxSEX_OR =
      int$OR,

    PGSxSEX_CI_low =
      int$CI_low,

    PGSxSEX_CI_high =
      int$CI_high,

    PGSxSEX_raw_p =
      int$raw_p,

    stringsAsFactors = FALSE
  )

  out
}

