###############################################################################
# HELPER: FIT SEX-STRATIFIED ORDINAL MODEL
###############################################################################

fit_sex_model <- function(data, outcome, sex_code, sex_label) {

  x <- data[data$SEX == sex_code, , drop = FALSE]

  model_vars <- c(outcome, covars)

  cc <- complete.cases(x[, model_vars, drop = FALSE])

  mdat <- x[cc, model_vars, drop = FALSE]

  cat("\n------------------------------------------------------------\n")
  cat(outcome, "-", sex_label, "\n")
  cat("------------------------------------------------------------\n")

  cat("Sex-specific cohort N =", nrow(x), "\n")
  cat(
    "Outcome available N =",
    sum(!is.na(x[[outcome]])),
    "\n"
  )
  cat(
    "Complete-case model N =",
    nrow(mdat),
    "\n"
  )

  if (nrow(mdat) == 0) {
    stop("No complete cases available.")
  }

  # Ordered response required for proportional-odds model.
  mdat[[outcome]] <- ordered(
    mdat[[outcome]],
    levels = sort(unique(mdat[[outcome]]))
  )

  form <- as.formula(
    paste(
      outcome,
      "~",
      paste(covars, collapse = " + ")
    )
  )

  fit <- polr(
    form,
    data = mdat,
    Hess = TRUE,
    method = "logistic"
  )

  sm <- coef(summary(fit))

  coef_names <- rownames(sm)

  z <- sm[, "Value"] / sm[, "Std. Error"]

  p <- 2 * pnorm(abs(z), lower.tail = FALSE)

  tab <- data.frame(
    outcome = outcome,
    sex = sex_label,
    sex_code = sex_code,
    N_model = nrow(mdat),
    term = coef_names,
    beta = sm[, "Value"],
    SE = sm[, "Std. Error"],
    z = z,
    raw_p = p,
    OR = exp(sm[, "Value"]),
    CI_low = exp(
      sm[, "Value"] -
        1.96 * sm[, "Std. Error"]
    ),
    CI_high = exp(
      sm[, "Value"] +
        1.96 * sm[, "Std. Error"]
    ),
    stringsAsFactors = FALSE
  )

  cat("\nFULL MODEL SUMMARY\n")
  print(summary(fit))

  cat("\nCOEFFICIENT TABLE\n")
  print(tab, row.names = FALSE)

  list(
    fit = fit,
    table = tab,
    N = nrow(mdat)
  )
}

###############################################################################
# HELPER: FIT COMBINED PGS x SEX INTERACTION
###############################################################################

fit_interaction_model <- function(data, outcome) {

  model_vars <- c(
    outcome,
    "CMP_PGS_Z",
    "SEX",
    "AGE",
    "MDD",
    pcs
  )

  cc <- complete.cases(
    data[, model_vars, drop = FALSE]
  )

  mdat <- data[
    cc,
    model_vars,
    drop = FALSE
  ]

  mdat[[outcome]] <- ordered(
    mdat[[outcome]],
    levels = sort(unique(mdat[[outcome]]))
  )

  # Male = reference; Female = level 2.
  mdat$SEX_factor <- factor(
    mdat$SEX,
    levels = c(1, 2),
    labels = c("Male", "Female")
  )

  form <- as.formula(
    paste0(
      outcome,
      " ~ CMP_PGS_Z * SEX_factor + AGE + MDD + ",
      paste(pcs, collapse = " + ")
    )
  )

  cat("\n============================================================\n")
  cat(outcome, "- CMP PGS x SEX INTERACTION\n")
  cat("============================================================\n")
  cat("Complete-case model N =", nrow(mdat), "\n")

  fit <- polr(
    form,
    data = mdat,
    Hess = TRUE,
    method = "logistic"
  )

  sm <- coef(summary(fit))

  z <- sm[, "Value"] / sm[, "Std. Error"]

  p <- 2 * pnorm(abs(z), lower.tail = FALSE)

  tab <- data.frame(
    outcome = outcome,
    N_model = nrow(mdat),
    term = rownames(sm),
    beta = sm[, "Value"],
    SE = sm[, "Std. Error"],
    z = z,
    raw_p = p,
    OR = exp(sm[, "Value"]),
    CI_low = exp(
      sm[, "Value"] -
        1.96 * sm[, "Std. Error"]
    ),
    CI_high = exp(
      sm[, "Value"] +
        1.96 * sm[, "Std. Error"]
    ),
    stringsAsFactors = FALSE
  )

  cat("\nFULL MODEL SUMMARY\n")
  print(summary(fit))

  cat("\nCOEFFICIENT TABLE\n")
  print(tab, row.names = FALSE)

  int_row <- grep(
    "CMP_PGS_Z:SEX_factor",
    tab$term
  )

  if (length(int_row) != 1) {
    stop(
      paste(
        "Could not uniquely identify interaction term.",
        "Terms:",
        paste(tab$term, collapse = ", ")
      )
    )
  }

  interaction <- tab[int_row, , drop = FALSE]

  cat("\nINTERACTION RESULT\n")
  print(interaction, row.names = FALSE)

  list(
    fit = fit,
    table = tab,
    interaction = interaction,
    N = nrow(mdat)
  )
}

