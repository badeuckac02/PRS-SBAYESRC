# ------------------------------------------------------------
# Function for proportional-odds model
# ------------------------------------------------------------

run_polr <- function(d, outcome, include_sex = FALSE,
                     interaction = FALSE) {

    d <- d[
        complete.cases(
            d[, c(
                outcome,
                "CMP_PGS_Z",
                "SEX",
                "AGE",
                "MDD",
                paste0("PC", 1:10)
            )]
        ),
    ]

    if (interaction) {

        form <- as.formula(
            paste0(
                "ordered(", outcome, ") ~ CMP_PGS_Z * factor(SEX) + ",
                "AGE + MDD + ",
                paste0("PC", 1:10, collapse = " + ")
            )
        )

    } else if (include_sex) {

        form <- as.formula(
            paste0(
                "ordered(", outcome, ") ~ CMP_PGS_Z + factor(SEX) + ",
                "AGE + MDD + ",
                paste0("PC", 1:10, collapse = " + ")
            )
        )

    } else {

        form <- as.formula(
            paste0(
                "ordered(", outcome, ") ~ CMP_PGS_Z + ",
                "AGE + MDD + ",
                paste0("PC", 1:10, collapse = " + ")
            )
        )
    }

    MASS::polr(
        form,
        data = d,
        Hess = TRUE,
        method = "logistic"
    )
}

# ------------------------------------------------------------
# Extract OR, CI and p-value
# ------------------------------------------------------------

extract_term <- function(model, term) {

    cf <- coef(summary(model))

    if (!(term %in% rownames(cf))) {
        stop("Term not found: ", term)
    }

    beta <- cf[term, "Value"]
    se   <- cf[term, "Std. Error"]

    z <- beta / se
    p <- 2 * pnorm(abs(z), lower.tail = FALSE)

    data.frame(
        Beta = beta,
        SE = se,
        OR = exp(beta),
        CI_lower = exp(beta - 1.96 * se),
        CI_upper = exp(beta + 1.96 * se),
        P = p
    )
}

# ============================================================
# FUNCTION TO GENERATE TABLE 4
# ============================================================

make_table4 <- function(outcome, label) {

    cat("\n============================================\n")
    cat(label, "-", outcome, "\n")
    cat("============================================\n")

    # Complete-case counts for this outcome
    vars <- c(
        outcome,
        "CMP_PGS_Z",
        "SEX",
        "AGE",
        "MDD",
        paste0("PC", 1:10)
    )

    cc <- cases[complete.cases(cases[, vars]), ]

    cat("\nComplete-case N =", nrow(cc), "\n")
    cat("Sex counts:\n")
    print(table(cc$SEX))

    # ----------------------------------------
    # Combined model WITH PGS x SEX interaction
    # ----------------------------------------

    combined <- run_polr(
        cases,
        outcome,
        interaction = TRUE
    )

    cat("\nCombined interaction model:\n")
    print(coef(summary(combined)))

    # Find interaction coefficient robustly
    int_term <- grep(
        "CMP_PGS_Z.*factor\\(SEX\\)|factor\\(SEX\\).*CMP_PGS_Z",
        names(coef(combined)),
        value = TRUE
    )

    if (length(int_term) != 1) {
        stop(
            "Could not uniquely identify PGS x sex interaction term. Found: ",
            paste(int_term, collapse = ", ")
        )
    }

    interaction_result <- extract_term(
        combined,
        int_term
    )

    # ----------------------------------------
    # Female model
    # ----------------------------------------

    female <- cases[cases$SEX == 2, ]

    female_model <- run_polr(
        female,
        outcome,
        include_sex = FALSE
    )

    female_pgs <- extract_term(
        female_model,
        "CMP_PGS_Z"
    )

    female_age <- extract_term(
        female_model,
        "AGE"
    )

    # ----------------------------------------
    # Male model
    # ----------------------------------------

    male <- cases[cases$SEX == 1, ]

    male_model <- run_polr(
        male,
        outcome,
        include_sex = FALSE
    )

    male_pgs <- extract_term(
        male_model,
        "CMP_PGS_Z"
    )

    male_age <- extract_term(
        male_model,
        "AGE"
    )

    # Complete-case Ns actually entering each model
    female_vars <- c(
        outcome, "CMP_PGS_Z", "AGE", "MDD",
        paste0("PC", 1:10)
    )

    male_vars <- female_vars

    female_N <- sum(complete.cases(female[, female_vars]))
    male_N   <- sum(complete.cases(male[, male_vars]))

    # ----------------------------------------
    # Final supplementary table
    # ----------------------------------------

    tab <- data.frame(
        Sex = c("Female", "Male"),

        N = c(
            female_N,
            male_N
        ),

        PGS_OR = c(
            female_pgs$OR,
            male_pgs$OR
        ),

        PGS_CI_lower = c(
            female_pgs$CI_lower,
            male_pgs$CI_lower
        ),

        PGS_CI_upper = c(
            female_pgs$CI_upper,
            male_pgs$CI_upper
        ),

        PGS_P = c(
            female_pgs$P,
            male_pgs$P
        ),

        Age_OR = c(
            female_age$OR,
            male_age$OR
        ),

        Age_CI_lower = c(
            female_age$CI_lower,
            male_age$CI_lower
        ),

        Age_CI_upper = c(
            female_age$CI_upper,
            male_age$CI_upper
        ),

        Age_P = c(
            female_age$P,
            male_age$P
        ),

        PGS_sex_interaction_P = c(
            interaction_result$P,
            NA
        )
    )

    cat("\nFINAL TABLE:\n")
    print(tab, digits = 10)

    # Save
    outfile <- file.path(
        outdir,
        paste0(
            "Supplementary_Table_4",
            ifelse(outcome == "PAINAVG", "A", "B"),
            "_FINAL_N4862.tsv"
        )
    )

    write.table(
        tab,
        outfile,
        sep = "\t",
        quote = FALSE,
        row.names = FALSE
    )

    cat("\nSaved:", outfile, "\n")

    invisible(tab)
}

